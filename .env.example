# Copy this file to .env.local and fill in a value for your machine.
# .env.local is gitignored — never commit real values here.
#
# EXPO_PUBLIC_* variables are baked into the JS bundle and readable by
# anyone with the app installed. Never put a secret in an EXPO_PUBLIC_*
# variable — this app only ever needs a public API base URL.
#
# There is deliberately no default/fallback value in code: an unset
# EXPO_PUBLIC_API_BASE_URL shows a "Configuration required" screen instead
# of silently pointing at production.

# iOS Simulator (the simulator shares your Mac's localhost):
# EXPO_PUBLIC_API_BASE_URL=http://localhost:3000

# Android Emulator (10.0.2.2 is the emulator's alias for your Mac's localhost):
# EXPO_PUBLIC_API_BASE_URL=http://10.0.2.2:3000

# Physical iPhone/Android device on the same Wi-Fi as your Mac — replace
# with your Mac's actual LAN IP (System Settings > Wi-Fi > Details, or
# `ipconfig getifaddr en0` in Terminal):
# EXPO_PUBLIC_API_BASE_URL=http://192.168.1.23:3000

EXPO_PUBLIC_API_BASE_URL=
